<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
	<!--
		Bar height. Must not contain any property other than "Height". If set, this
		overwrites `BarConfig._height`. It does not bear a *direct* effect on the UI.
	-->
	<Style x:Key="bar:height" TargetType="RelativePanel">
		<Setter Property="Height" Value="30" />
	</Style>
	<!--
		Bar font size. BarPlugin overwrites this at runtime with BarConfig.FontSize before the bar
		windows are created, so styles which read it via ThemeResource pick up the configured size.
		Used for widgets whose text does not inherit FontSize from the bar (e.g. the workspace and
		active-layout buttons).
	-->
	<x:Double x:Key="bar:font_size">14</x:Double>
	<!--  Font family  -->
	<FontFamily x:Key="_font:family">Segoe UI</FontFamily>
	<!--  Explicit colors, other colors are inherited from the system settings  -->
	<Color x:Key="bar:active_workspace:background">#81a1c180</Color>
	<Color x:Key="bar:active_workspace:foreground">#1c1c1c</Color>
	<Color x:Key="bar:hover:background">#15777777</Color>
	<Color x:Key="bar:hover:foreground">#da777777</Color>
	<!--
		Shared text block style. FontSize is intentionally not set here so that bar text inherits
		the size configured via BarConfig.FontSize (applied to each widget in BarWindow).
		FlowDirection is forced left-to-right so that text is not visually reordered when the widget
		sits in the right-hand panel, which lays its widgets out right-to-left (e.g. a
		"yyyy-MM-dd HH:mm" date would otherwise render with the time before the date).
	-->
	<Style x:Key="_base:text_block" TargetType="TextBlock">
		<Setter Property="Margin" Value="0" />
		<Setter Property="Padding" Value="8,2,8,3" />
		<Setter Property="FontFamily" Value="{StaticResource _font:family}" />
		<Setter Property="FlowDirection" Value="LeftToRight" />
	</Style>
	<!--
		Shared button style. FontSize is intentionally not set here so that bar buttons inherit the
		size configured via BarConfig.FontSize (applied to each widget in BarWindow).
	-->
	<Style x:Key="_base:button" TargetType="Button">
		<Setter Property="Margin" Value="3,0" />
		<Setter Property="Padding" Value="8,2,8,3" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="FontFamily" Value="{StaticResource _font:family}" />
		<!--  Buttons do not inherit the bar's FontSize across the ItemsControl/DropDown boundary, so set it explicitly.  -->
		<Setter Property="FontSize" Value="{ThemeResource bar:font_size}" />
	</Style>
	<!--  Shared font icon style  -->
	<Style x:Key="_base:font_icon" TargetType="FontIcon">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontFamily" Value="Segoe Fluent Icons" />
	</Style>
	<!--  Root panel  -->
	<Style x:Key="bar:root_panel" TargetType="RelativePanel">
		<Setter Property="Margin" Value="0" />
		<Setter Property="Padding" Value="0,2" />
	</Style>
	<!--  Sub panels  -->
	<Style x:Key="_sub_panel" TargetType="StackPanel" />
	<StaticResource x:Key="bar:left_panel" ResourceKey="_sub_panel" />
	<StaticResource x:Key="bar:center_panel" ResourceKey="_sub_panel" />
	<StaticResource x:Key="bar:right_panel" ResourceKey="_sub_panel" />
	<!--  Widget stack panels  -->
	<Style x:Key="_widget_stack_panel" TargetType="StackPanel">
		<Setter Property="Orientation" Value="Horizontal" />
	</Style>
	<!--  Active layout widget  -->
	<Style x:Key="bar:active_layout:button" BasedOn="{StaticResource _base:button}" TargetType="DropDownButton" />
	<!--  Tree layout engine widget  -->
	<Style x:Key="bar:tree_layout:button" BasedOn="{StaticResource _base:button}" TargetType="DropDownButton" />
	<!--  Tree layout engine widget  -->
	<Style x:Key="bar:tree_layout:button" BasedOn="{StaticResource _base:button}" TargetType="DropDownButton" />
	<!--  Workspace widget  -->
	<Style x:Key="bar:workspace:button" BasedOn="{StaticResource _base:button}" TargetType="Button">
		<Setter Property="Margin" Value="0" />
	</Style>
	<!--  Focused window widget  -->
	<StaticResource x:Key="bar:focused_window:text_block" ResourceKey="_base:text_block" />
	<!--  Date time widget. Inherits the configured bar font size from _base:text_block.  -->
	<StaticResource x:Key="bar:date_time:text_block" ResourceKey="_base:text_block" />
	<!--  Battery widget  -->
	<Style x:Key="bar:battery:stack_panel" BasedOn="{StaticResource _widget_stack_panel}" TargetType="StackPanel">
		<Setter Property="Margin" Value="3,0" />
		<Setter Property="Padding" Value="8,2,8,3" />
		<Setter Property="Spacing" Value="8" />
	</Style>
	<Style x:Key="bar:battery:font_icon" BasedOn="{StaticResource _base:font_icon}" TargetType="FontIcon">
		<Setter Property="FontSize" Value="16" />
	</Style>
	<Style x:Key="bar:battery:text_block" BasedOn="{StaticResource _base:text_block}" TargetType="TextBlock">
		<Setter Property="Margin" Value="0" />
		<Setter Property="Padding" Value="0" />
	</Style>
</ResourceDictionary>
